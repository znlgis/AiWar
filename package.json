{
  "name": "aiwar",
  "private": true,
  "version": "0.2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @aiwar/site dev",
    "build": "pnpm --filter @aiwar/site build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "toy:check": "node scripts/check-toy.mjs",
    "toy:doctor": "python scripts/toy_doctor.py apps/site/dist --poster release/poster.png --slug aiwar-guiling",
    "toy:zip": "python scripts/zip-dist.py",
    "preview:toy": "node scripts/preview-toy-subpath.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm toy:zip && pnpm toy:check && pnpm toy:doctor"
  }
}
